; ==========================================================
; 3) 基础调度与兜底策略组（扁平化出口）
; ==========================================================

; 手动代理备用池
custom_proxy_group=🚀 手动选择`select`[]♻️ 自动选择`[]🇭🇰 HK`[]🇹🇼 TW`[]🇯🇵 JP`[]🇸🇬 SG`[]🇺🇸 US`[]🧊 冷门节点`[]🧭 手动选择`[]DIRECT

; 最终出口（收纳所有未匹配流量）
custom_proxy_group=🌐 Default`select`[]🇭🇰 HK`[]🇹🇼 TW`[]🇯🇵 JP`[]🇸🇬 SG`[]🇺🇸 US`[]🧊 冷门节点`[]♻️ 自动选择`[]🧭 手动选择`[]DIRECT


; ==========================================================
; 4) 节点自动测速与国家分类组（关键修正：双反斜杠转义）
; ==========================================================
custom_proxy_group=🧭 手动选择`select`^(?!.*(剩余|重置|到期|套餐)).*$
custom_proxy_group=♻️ 自动选择`url-test`^(?!.*(剩余|重置|到期|套餐)).*$`https://www.gstatic.com/generate_204`300,,50

custom_proxy_group=🇭🇰 HK`url-test`(?i)(🇭🇰|香港|\\bHK\\b|hongkong)`http://www.gstatic.com/generate_204`300,,50
custom_proxy_group=🇹🇼 TW`url-test`(?i)(🇹🇼|台湾|\\bTW\\b|taiwan|taipei|hinet)`http://www.gstatic.com/generate_204`300,,50
custom_proxy_group=🇯🇵 JP`url-test`(?i)(🇯🇵|日本|\\bJP\\b|tokyo|osaka)`http://www.gstatic.com/generate_204`300,,50
custom_proxy_group=🇸🇬 SG`url-test`(?i)(🇸🇬|新加坡|\\bSG\\b|singapore)`http://www.gstatic.com/generate_204`300,,50
custom_proxy_group=🇺🇸 US`url-test`(?i)(🇺🇸|美国|\\bUS\\b|united states|los angeles|san jose|seattle|new york)`http://www.gstatic.com/generate_204`300,,50

; 冷门节点池（剔除五大主流地区和信息节点）
custom_proxy_group=🧊 冷门节点`select`^(?!.*(🇭🇰|香港|HK|Hong\\s*Kong|🇯🇵|日本|JP|Tokyo|Osaka|🇹🇼|台湾|TW|Taiwan|Taipei|Hinet|🇸🇬|新加坡|SG|Singapore|🇺🇸|美国|US|United\\s*States|Los\\s*Angeles|San\\s*Jose|Seattle|New\\s*York|剩余|重置|到期|套餐)).*$
